    {
      "name": "7919cb0a",
      "displayName": "kpi",
      "queryLines": [
        "SELECT \n",
        "  (SELECT COUNT(*) FROM marathos.gold.fct_results) AS total_results,\n",
        "  (SELECT COUNT(*) FROM marathos.gold.dim_event) AS total_events,\n",
        "  (SELECT COUNT(*) FROM marathos.gold.dim_athlete) AS total_athletes,\n",
        "  (SELECT COUNT(DISTINCT athlete_country) FROM marathos.gold.dim_athlete WHERE athlete_country IS NOT NULL) AS total_countries;"
      ]
    },
    {
      "name": "9913c6d3",
      "displayName": "top_countrys",
      "queryLines": [
        "SELECT athlete_country, \n",
        "        COUNT(*) AS athletes\n",
        "FROM marathos.gold.dim_athlete\n",
        "WHERE athlete_country IS NOT NULL\n",
        "GROUP BY athlete_country\n",
        "ORDER BY athletes DESC\n",
        "LIMIT 15;"
      ]
    },
    {
      "name": "afad9631",
      "displayName": "Performance",
      "queryLines": [
        "SELECT \n",
        "    FLOOR(performance_seconds / 3600) As finish_time_hours_bucket,\n",
        "    COUNT(*) AS runner_count\n",
        "FROM marathos.gold.fct_results\n",
        "WHERE performance_seconds IS NOT NULL \n",
        "    AND performance_seconds > 0\n",
        "GROUP BY 1\n",
        "ORDER BY 1;"
      ]
    }
