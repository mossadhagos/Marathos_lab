{
  "datasets": [
    {
      "name": "f8b8c73b",
      "displayName": "sql_dataset",
      "queryLines": [
        "SELECT COUNT(*) AS total_results\n",
        "FROM marathos.gold.fct_results;\n",
        "\n",
        "SELECT COUNT (*) AS total_events\n",
        "FROM marathos.gold.dim_event;\n",
        "\n",
        "SELECT COUNT (*) AS total_athletes\n",
        "FROM marathos.gold.dim_athlete;\n",
        "\n",
        "SELECT COUNT(DISTINCT athlete_country) AS countries_represented\n",
        "FROM marathos.gold.dim_athlete\n",
        "WHERE athlete_country IS NOT NULL;\n",
        "\n",
        "SELECT (FLOOR(athlete_age / 10) * 10) AS age_decade,\n",
        "        COUNT(*) AS runners\n",
        "FROM marathos.gold.fct_results\n",
        "WHERE athlete_age IS NOT NULL\n",
        "GROUP BY age_decade\n",
        "ORDER BY age_decade;\n"
      ],
      "catalog": "marathos",
      "schema": "gold"
    },
